# Twitch application credentials (create one at https://dev.twitch.tv/console/apps)
# Only client-credentials flow is used; no OAuth redirect URL needed.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Public URL this service is reachable at (behind your reverse proxy / TLS).
# Used in the generated /sw.js and the subscribe popup.
PUBLIC_BASE_URL=http://localhost:8080

# --- Optional ---

# PORT=8080
# DB_PATH=data/notify.db
# POLL_INTERVAL_SECONDS=60

# Comma-separated Twitch logins this instance is allowed to watch.
# Empty = any channel someone subscribes to gets polled. Recommended in production.
# CHANNEL_ALLOWLIST=somechannel,otherchannel

# Comma-separated origins allowed to call the API. Empty = open CORS (*).
# ALLOWED_ORIGINS=https://somechannel.example

# Contact for the VAPID subject (push services may use it to reach you).
# VAPID_SUBJECT=mailto:you@example.com

# When set, enables POST /api/test/notify (Authorization: Bearer <token>).
# ADMIN_TOKEN=
